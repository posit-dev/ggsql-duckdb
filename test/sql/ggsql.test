# name: test/sql/ggsql.test
# description: test ggsql extension
# group: [sql]

#
# Run with GGSQL_NO_OPEN_BROWSER=1 in the environment to prevent the Rust side
# from launching a browser tab for each test query.

# Before the extension loads, ggsql('...') is an unknown function
statement error
SELECT ggsql('VISUALISE FROM ggsql:penguins DRAW point');
----
Catalog Error

require ggsql

# Parser extension must decline a statement whose only use of VISUALISE is inside a
# string literal. If it claimed it, we'd get an error from the ggsql pipeline.
query I
SELECT 'I love VISUALISE' AS s;
----
I love VISUALISE

# Parser extension must also decline when VISUALISE appears in a line comment.
query I
SELECT 1 AS x; -- VISUALISE would be nice
----
1

# --------------------------------------------------------------------------------
# Default mode is 'silent' — the parser-extension form produces no result set
# at all (StatementReturnType::NOTHING), so the statement is accepted with no
# rendered output even though the ggsql pipeline ran and served the plot.
# --------------------------------------------------------------------------------
statement ok
SELECT * FROM (VALUES (1, 10), (2, 20)) AS t(x, y) VISUALISE x, y DRAW point;

# Explicit 'url' mode — returns the plot URL.
statement ok
SET ggsql_output = 'url';

query I
SELECT ggsql('SELECT 1 AS x, 2 AS y VISUALISE x, y DRAW point')
  LIKE 'http://127.0.0.1:%';
----
true

# 'spec' mode — returns the vega-lite JSON as a VARCHAR, no server, no browser.
statement ok
SET ggsql_output = 'spec';

query I
SELECT ggsql('SELECT 1 AS x, 2 AS y VISUALISE x, y DRAW point')
  LIKE '%vega-lite%';
----
true

# 'html' mode — returns a self-contained HTML document rendering the .hep plot
# document with the inlined hephaestus wasm viewer.
statement ok
SET ggsql_output = 'html';

query I
SELECT ggsql('SELECT 1 AS x, 2 AS y VISUALISE x, y DRAW point')
  LIKE '<!doctype html>%';
----
true

query I
SELECT ggsql('SELECT 1 AS x, 2 AS y VISUALISE x, y DRAW point')
  LIKE '%ggsqlRenderHep%';
----
true

# The inlined viewer + wasm/font assets should make the HTML payload large.
# (~1.9 MB of viewer/assets; a bare .hep document is a few KB.)
query I
SELECT length(ggsql('SELECT 1 AS x, 2 AS y VISUALISE x, y DRAW point')) > 1000000;
----
true

# --------------------------------------------------------------------------------
# Native writers: svg (text), pdf and hep (binary). These bypass vega-lite and
# the HTTP server entirely; sizing and appearance come from
# ggsql_writer_options.
# --------------------------------------------------------------------------------

# 'svg' mode — returns the plot as SVG markup.
statement ok
SET ggsql_output = 'svg';

query I
SELECT ggsql('SELECT 1 AS x, 2 AS y VISUALISE x, y DRAW point') LIKE '%<svg%';
----
true

# Writer options passthrough: an explicit pixel width lands on the root element.
statement ok
SET ggsql_writer_options = 'width=321';

query I
SELECT ggsql('SELECT 1 AS x, 2 AS y VISUALISE x, y DRAW point') LIKE '%321%';
----
true

# Unknown option keys are rejected by the writer with a message naming the key.
statement ok
SET ggsql_writer_options = 'wodth=100';

statement error
SELECT ggsql('SELECT 1 AS x, 2 AS y VISUALISE x, y DRAW point');
----
unknown writer option

# Options must not be silently ignored by the vega-lite 'spec' mode (they do
# apply to the browser display, which renders through hephaestus).
statement ok
SET ggsql_output = 'spec';
SET ggsql_writer_options = 'width=100';

statement error
SELECT ggsql('SELECT 1 AS x, 2 AS y VISUALISE x, y DRAW point');
----
does not apply

statement ok
RESET ggsql_writer_options;

# 'pdf' mode — ggsql_run types the payload as BLOB; the file starts with %PDF.
statement ok
SET ggsql_output = 'pdf';

# ('%PDF' as hex is 25504446.)
query I
SELECT substr(hex(plot), 1, 8) = '25504446' FROM ggsql_run('SELECT 1 AS x, 2 AS y VISUALISE x, y DRAW point');
----
true

# 'hep' mode — also a BLOB; a real document is well over a hundred bytes.
statement ok
SET ggsql_output = 'hep';

query I
SELECT octet_length(plot) > 100 FROM ggsql_run('SELECT 1 AS x, 2 AS y VISUALISE x, y DRAW point');
----
true

# --------------------------------------------------------------------------------
# ggsql_save(query, path): the writer is inferred from the file extension and
# the payload written to disk. ggsql_output does not apply; ggsql_writer_options
# does.
# --------------------------------------------------------------------------------
statement ok
RESET ggsql_output;

statement ok
SET ggsql_writer_options = 'width=432';

# Saving to .svg writes SVG markup (sized by the writer options) and returns
# the path.
query I
SELECT ggsql_save('SELECT 1 AS x, 2 AS y VISUALISE x, y DRAW point', '__TEST_DIR__/ggsql_save_test.svg')
  LIKE '%ggsql_save_test.svg';
----
true

query I
SELECT content LIKE '%<svg%432%' FROM read_text('__TEST_DIR__/ggsql_save_test.svg');
----
true

# Saving to .pdf writes binary PDF.
query I
SELECT ggsql_save('SELECT 1 AS x, 2 AS y VISUALISE x, y DRAW point', '__TEST_DIR__/ggsql_save_test.pdf')
  LIKE '%ggsql_save_test.pdf';
----
true

query I
SELECT substr(hex(content), 1, 8) = '25504446' FROM read_blob('__TEST_DIR__/ggsql_save_test.pdf');
----
true

# Unknown extensions are rejected before any rendering happens.
statement error
SELECT ggsql_save('SELECT 1 AS x, 2 AS y VISUALISE x, y DRAW point', '__TEST_DIR__/plot.bmp');
----
unsupported output format

statement ok
RESET ggsql_writer_options;

# Unknown mode values should surface a clear error rather than silently falling back.
statement ok
SET ggsql_output = 'nope';

statement error
SELECT ggsql('SELECT 1 AS x, 2 AS y VISUALISE x, y DRAW point');
----
unrecognised value

# Reset so the default path keeps working after a setting change.
statement ok
RESET ggsql_output;

# After RESET we're back to the silent default — parser-extension form produces
# no result set at all.
statement ok
SELECT 1 AS x, 2 AS y VISUALISE x, y DRAW point;
